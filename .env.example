# Copy this file to .env.local and fill in the values you need.

# The canonical URL of the deployed site. Used for metadata, Open Graph
# images, sitemap.xml and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://theninjadev.dev

# --- Contact form (optional) ---
# The form works without these: it validates in the browser and falls back to
# opening the visitor's email client. Set these to have submissions delivered
# to your inbox instead.
#
# Note: Resend sends FROM a domain you own and have verified — you can't send
# from a Gmail address. Without a domain, either use onboarding@resend.dev
# (which will only deliver to your own verified address, so it's fine for
# testing but not for real enquiries), or use a form service like Web3Forms
# or Formspree, which just needs a destination address.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=kabirusamimadeiza@gmail.com
